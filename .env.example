# ─────────────────────────────────────────────────────────────
# Outreach Dialer — environment. Copy to `.env` and fill in.
# Everything here is SERVER-SIDE ONLY. Nothing is exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Postgres. Local dev: port 5433. VPS: the server's Postgres on 5432 (docs/deploy.md).
DATABASE_URL="postgresql://dialer:dialer@localhost:5433/dialer?schema=public"

# Public HTTPS URL Twilio can reach (your VPS domain, or a tunnel URL in dev).
# Used to build webhook URLs and to verify Twilio request signatures.
PUBLIC_BASE_URL="https://dialer.example.com"

# Long random string (e.g. `openssl rand -base64 48`). Signs login sessions.
SESSION_SECRET=""

# ── Twilio (Console home page) ──
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN=""
# Account → API keys & tokens → Create API key (Standard)
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET=""
# Voice → TwiML Apps → your app's SID
TWILIO_TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Your current US number (E.164). Used as default caller ID and alert sender.
TWILIO_DEFAULT_NUMBER="+1XXXXXXXXXX"

# Nearest Twilio edge for call audio. "singapore" is closest to Pakistan; "roaming" = auto.
TWILIO_VOICE_EDGE="roaming"
# Timezone for dates in the UI and the follow-up digest.
APP_TIMEZONE="Asia/Karachi"
# Hour (UTC) from which the daily follow-up digest email goes out. 4 = 09:00 PKT.
DIGEST_HOUR_UTC="4"

# Country assumed when a number is typed without "+…" (e.g. "(212) 555-0147").
NEXT_PUBLIC_DEFAULT_COUNTRY="US"
# Refuse outbound calls to destinations above this USD/min (cost & toll-fraud guard).
# US is $0.014/min; premium-rate numbers can be dollars per minute.
MAX_CALL_RATE_USD="0.50"
# Played to the called party on answer while recording (two-party-consent US states such
# as CA, FL, IL, PA, WA). Set to "" to turn off.
RECORDING_NOTICE="This call may be recorded for quality purposes."

# Record calls (Phase 3). "true" | "false". Check consent rules for the
# countries you call — some require telling the other party.
CALL_RECORDING="true"
# Seconds to ring online team members before voicemail (plan: 20-25).
INBOUND_RING_TIMEOUT="22"
VOICEMAIL_GREETING="Thanks for calling Assosiatix. We can't take your call right now. Please leave your name, company and a short message after the tone, and we'll call you back."

# ── Missed-call / voicemail alerts ──
# SMS alerts go to each team member's "alert phone" (set on the Team page).
ALERT_SMS_ENABLED="true"
# Email alerts via Resend (resend.com). Sender domain must be verified there.
RESEND_API_KEY=""
ALERT_EMAIL_FROM="Outreach Dialer <dialer@assosiatix.com>"

# Protects /api/cron/* (daily follow-up digest). Long random string.
CRON_SECRET=""

# Dev only: skip Twilio signature checks when curling webhooks locally.
# NEVER set this in production.
TWILIO_SKIP_SIGNATURE="false"

# Seed (pnpm db:seed) — creates/updates the first team members.
# Format: name|email|password|role|alertPhone ; separated by ;
SEED_MEMBERS="Rehan|rehan@assosiatix.com|change-me-now|admin|;Caller Two|caller2@assosiatix.com|change-me-too|caller|"
